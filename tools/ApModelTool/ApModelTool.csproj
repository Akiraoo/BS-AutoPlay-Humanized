<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoReplay.Tools</RootNamespace>
    <!-- 遊戲外生成回放: 和模組共用生成器原始碼, 用 Standalone/ 裡的 Unity / 遊戲型別替代品 -->
    <DefineConstants>$(DefineConstants);AUTOPLAY_STANDALONE</DefineConstants>
  </PropertyGroup>

  <!-- 和模組共用 Core (模型格式/訓練器), 保證兩邊結果一致 -->
  <ItemGroup>
    <Compile Include="..\..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 和模組共用的生成器 (揮刀規劃 / 頭 / 手 / 人體模型), 遊戲內外是同一份程式 -->
  <ItemGroup>
    <Compile Include="..\..\MotionGenerator.cs" Link="Generator\MotionGenerator.cs" />
    <Compile Include="..\..\NoteSwingPlanner.cs" Link="Generator\NoteSwingPlanner.cs" />
    <Compile Include="..\..\PoseCalculator.cs" Link="Generator\PoseCalculator.cs" />
    <Compile Include="..\..\HumanModel.cs" Link="Generator\HumanModel.cs" />
    <Compile Include="..\..\SwingTemplates.cs" Link="Generator\SwingTemplates.cs" />
    <Compile Include="..\..\RollOffsets.cs" Link="Generator\RollOffsets.cs" />
    <Compile Include="..\..\ArmTemplates.cs" Link="Generator\ArmTemplates.cs" />
    <Compile Include="..\..\AutoReplayMath.cs" Link="Generator\AutoReplayMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
